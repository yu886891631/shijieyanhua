+    protocol: T15_DB_COMPLETION_PROTOCOL,
+    coverage: Object.freeze(['automatic-plan'] as const),
+    candidateOnly: true,
+    subscribe(fn: (event: T15DbEvent) => void) {
+      if (closed) throw new Error('source closed');
